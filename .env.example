# Public HTTPS origin of this server. Do not include a path other than the
# optional trailing /mcp accepted by jmap-mcp.
JMAP_MCP_RESOURCE_URL=https://jmap-mcp.your-domain.example

# Logto OIDC issuer and Stalwart JMAP base.
JMAP_MCP_AUTHORIZATION_SERVER=https://login.your-domain.example/oidc
JMAP_MCP_STALWART_JMAP_BASE_URL=https://mail.your-domain.example

# Public Logto application used by the dynamic-client-registration shim.
JMAP_MCP_DCR_CLIENT_ID=replace-with-logto-public-client-id

# Exact comma-separated callback URIs accepted from MCP clients.
JMAP_MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,claude://claude.ai/oauth/callback,claude://oauth/callback,cowork://oauth/callback

JMAP_MCP_BIND_ADDR=0.0.0.0:3000
JMAP_MCP_METRICS_BIND_ADDR=127.0.0.1:9090
JMAP_MCP_TRUSTED_PROXY_HOPS=0
JMAP_MCP_LOG_FORMAT=json
RUST_LOG=jmap_mcp=info,tower_http=info

# Additional addresses this mailbox may send as, beyond its JMAP identities.
# Stalwart exposes a principal's aliases only via x:Account/get and
# x:Account/query, which need the sysAccountGet / sysAccountQuery permissions
# that an ordinary user token does not carry — so aliases must be named here.
# Comma- or whitespace-separated. Role addresses (team@, postmaster@, ...) are
# refused: they are shared inboxes, never a personal From.
JMAP_MCP_EXTRA_FROM_ADDRESSES=you@your-domain.example
